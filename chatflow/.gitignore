# ==========================================
# ChatFlow - Subfolder .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/

# FastAPI / Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local database files
*.db
*.sqlite
*.sqlite3

# Local uploads & media
uploads/
**/uploads/
media/
**/media/

# Node & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*

# React / Vite build output
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
